# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=docverify
DB_USER=postgres
DB_PASSWORD=your_password_here

# Server
PORT=3000
NODE_ENV=development

# Your public domain (used to build QR code URLs)
BASE_URL=https://yourcompany.com

# Optional: secret for signing doc IDs (adds tamper-evidence)
# openssl rand -hex 32
DOC_SECRET=replace_with_a_long_random_secret

# Test SIS with dummy students at /mock-sis (src/routes/mockSis.js). Leave off
# in production unless you're demonstrating the matric lookup. In production
# MOCK_SIS_TOKEN must be set and at least 24 characters.
# MOCK_SIS_ENABLED=1
# MOCK_SIS_TOKEN=test-sis-token

# Monitoring (OpenTelemetry to Grafana Cloud). Leave empty locally: telemetry is off without the endpoint.
# Set in Render only; values come from the Grafana Cloud OpenTelemetry tile.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=univerify
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production
